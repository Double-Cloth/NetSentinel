@startuml
skinparam defaultFontName Microsoft YaHei
start
if (管理员配置或预览来源？) then (是)
  :校验授权、格式及时间参数;
  if (配置有效？) then (是)
    :按需执行有界连接预览，保留原断点;
  else (否)
    :返回字段错误;
  endif
  stop
endif
:到期调度或管理员重试;
if (来源启用且租约可领取？) then (是)
  :锁定配置版本及已提交断点;
else (否)
  :跳过停用或已有活动尝试的来源;
  stop
endif
:验证授权和主机身份，从断点有界读取;
if (读取成功且文件代次可确认？) then (是)
  :按换行截取完整行，保留尾部半行;
else (否)
  :记录阶段及失败码，保留已提交断点;
  stop
endif
if (有完整行？) then (是)
  if (原始片段持久化成功？) then (是)
    :解析完整行并记录统计及异常行;
  else (否)
    :记录存储失败，保留已提交断点;
    stop
  endif
else (否)
  :记录空尝试，保留断点;
  stop
endif
if (有有效事件？) then (是)
  :按时间和行号排序，分配事件序号;
  :暂存批次、分析意图、审计及断点;
else (否)
  :暂存诊断、统计、审计及已消费断点;
endif
if (配置版本和起始断点仍匹配且事务提交成功？) then (是)
  :展示本次结果及下次采集时间;
else (否)
  :回滚数据库，记录失败并保留断点;
endif
stop
@enduml
