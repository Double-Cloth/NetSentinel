@startuml
skinparam defaultFontName Microsoft YaHei
actor 浏览器
node "单机 Docker Compose" {
  node "Web / Nginx" as Web
  node "API 容器" as API {
    component "HTTP API" as HTTP
    component "调度与采集工作者" as Collector
    component "解析与批次发布" as Publisher
    component "分析工作者" as Worker
    component "Go 独立引擎" as Engine
    Collector --> Publisher : 完整字节与来源快照
    Worker --> Engine : 有序事件迭代器
    Engine --> Worker : Finding 接收器
  }
  node "一次性迁移容器" as Migrate
  database "持久化卷\nSQLite 与原文" as Data
  artifact "部署授权与只读凭据" as Secrets
}
node "授权 SFTP 日志源" as Source {
  artifact "稳定追加文件与代次文件"
}
浏览器 --> Web : 同源
Web --> HTTP : /api
Migrate --> Data : 应用编号迁移
HTTP --> Data : 已提交状态与证据
Collector --> Secrets : 授权配置及主机公钥
Collector --> Source : 固定主机身份与只读读取
Publisher --> Data : 原文、断点、批次、分析意图
Worker --> Data : 快照与结果发布
caption v0.1 设计拓扑，采集及分析工作者待实现
@enduml
